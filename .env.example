# Параметры подключения к базе данных PostgreSQL
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=office_map
DB_HOST=localhost
DB_PORT=5432
APP_NAME="Office Map Printer Monitor"
CORS_URL=http://localhost:3000,http://127.0.0.1:3000

# Параметры подключения к базе данных Redis/DragonFly
DRAGONFLY_URL="redis://localhost:6379/0"

# Настройки бэкенда FastAPI
PROJECT_NAME="Office Map API"
JWT_SECRET_KEY=super_secret_key_change_me_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Настройки фронтенда Next.js
# Так как мы используем Nginx в качестве прокси на порту 80,
# фронтенд может отправлять запросы на бэкенд по относительному пути /api.
# Но если потребуется абсолютный URL (например, для SSR):
NEXT_PUBLIC_API_URL=http://localhost/api

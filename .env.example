# ==========================================
# БЭКЕНД (FastAPI, Базы данных)
# ==========================================
PROJECT_NAME="Office Map API"
APP_NAME="Office Map Printer Monitor"
CORS_URL=http://localhost:3000,http://localhost
PRINTER_POLLING_INTERVAL=10
MAX_CONCURRENT_TASKS=10
SELENIUM_POOL_SIZE=8

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=office_map
DB_HOST=localhost
DB_PORT=5432

# Redis / DragonFly
DRAGONFLY_URL="redis://dragonfly:6379/0"

# ==========================================
# ФРОНТЕНД (Next.js Runtime Config)
# ==========================================
# URL бэкенда, к которому обращается браузер
API_URL=http://localhost:8000

# Частота фонового опроса принтеров в мс (60000 = 1 минута)
POLLING_INTERVAL=60000

# Цветовая тема (HEX коды)
THEME_BG=#0a0a0a
THEME_BRAND=#f59e0b
THEME_BRAND_HOVER=#fbbf24
THEME_BRAND_DARK=#d97706